PORT=8787
CORS_ORIGIN=http://localhost:3000

# xAI — set locally or as a Cloudflare secret; never commit real credentials
XAI_API_KEY=
XAI_WEBHOOK_SECRET=

# Cloudflare resources (configure when deploying)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_DATABASE_ID=
CLOUDFLARE_R2_BUCKET=

# SIP/VoIP provider has not yet been selected
SIP_PROVIDER=
SIP_TRUNK_URI=

# Configure only after authentication and tenant isolation are implemented
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
